{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Setlist",
  "version": "0.1.0",
  "identifier": "com.setlist.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Setlist",
        "width": 1100,
        "height": 750,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://sdk.scdn.co",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.spotify.com wss://*.spotify.com https://*.scdn.co https://*.spotifycdn.com",
        "img-src": "'self' data: https://*.scdn.co https://*.spotifycdn.com https://*.spotify.com",
        "media-src": "'self' blob: https://*.scdn.co https://*.spotifycdn.com https://*.spotify.com",
        "frame-src": "https://sdk.scdn.co https://*.spotify.com",
        "worker-src": "'self' blob:",
        "style-src": "'self'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' https://sdk.scdn.co",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.spotify.com wss://*.spotify.com https://*.scdn.co https://*.spotifycdn.com",
        "img-src": "'self' data: https://*.scdn.co https://*.spotifycdn.com https://*.spotify.com",
        "media-src": "'self' blob: https://*.scdn.co https://*.spotifycdn.com https://*.spotify.com",
        "frame-src": "https://sdk.scdn.co https://*.spotify.com",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": ["English"],
        "customLanguageFiles": { "English": "nsis/English.nsh" },
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
