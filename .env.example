# Copy to .env for local testing of templates/poll-plays.ts (the same script the
# Setup screen scaffolds into your data repo). NEVER commit .env.
# In production these live as GitHub Actions secrets on your data repo, not in this file.

SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=
# Recommended: with the client secret set, refreshes don't rotate the refresh
# token, so the stored value stays valid indefinitely. Without it, Spotify
# rotates the token on first use and this value goes stale.
SPOTIFY_CLIENT_SECRET=
